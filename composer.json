{
	"name": "vqueue/connector",
	"description": "Protección de cola de VQueue para apps PHP. El cliente la instala en su propio backend.",
	"type": "library",
	"license": "proprietary",
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.5"
	},
	"autoload": {
		"psr-4": { "VQueue\\Connector\\": "src/" }
	},
	"autoload-dev": {
		"psr-4": { "VQueue\\Connector\\Tests\\": "tests/" }
	},
	"scripts": {
		"test": "phpunit"
	},
	"config": { "sort-packages": true }
}
